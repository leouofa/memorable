<% content_for :title, "#{@memory.title} — Memorable" %>

<div class="max-w-5xl mx-auto space-y-6"
     data-controller="markdown-editor"
     data-markdown-editor-mode-value="preview"
     data-markdown-editor-save-url-value="<%= memory_path(@memory) %>">

  <!-- Breadcrumbs & Meta -->
  <div class="flex items-center justify-between text-xs font-mono text-neutral-500">
    <div class="flex items-center gap-1.5 flex-wrap">
      <%= link_to "Memorable", root_path, class: "hover:text-neutral-300 transition" %>
      <span>/</span>
      <%= link_to "All Memories", memories_path, class: "hover:text-neutral-300 transition" %>
      <span>/</span>
      <span class="text-neutral-300 truncate max-w-[200px]"><%= @memory.title %></span>
    </div>

    <!-- Live Save Status Indicator -->
    <div class="flex items-center gap-2">
      <span data-markdown-editor-target="statusIndicator" class="text-xs font-mono text-neutral-500">
        Saved
      </span>
      <span class="text-neutral-600">|</span>
      <span class="text-[11px] text-neutral-500 font-mono">⌘S to save</span>
    </div>
  </div>

  <!-- Header Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-neutral-800/80">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2">
          <%= @memory.title %>
        </h1>
      </div>

      <div class="flex items-center gap-2 mt-1.5 flex-wrap">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono bg-violet-950/70 text-violet-400 border border-violet-800/50">
          Memory
        </span>

        <% if @memory.embedded? %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono bg-emerald-950/70 text-emerald-400 border border-emerald-800/50" title="Embedded <%= time_ago_in_words(@memory.embedded_at) if @memory.embedded_at %> ago">
            <svg class="w-2 h-2 fill-current" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
            Vectorized (<%= @memory.embedding_model %>)
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono bg-neutral-800 text-neutral-400 border border-neutral-700/60">
            Unembedded
          </span>
        <% end %>

        <span class="text-neutral-600 text-xs font-mono">•</span>
        <span class="text-xs text-neutral-500 font-mono">Updated <%= time_ago_in_words(@memory.updated_at) %> ago</span>
      </div>
    </div>

    <!-- Actions Toolbar -->
    <div class="flex items-center gap-2 flex-wrap">
      <!-- Generate / Update Vector Embedding Button -->
      <%= button_to generate_embedding_memory_path(@memory),
                    method: :post,
                    title: @memory.embedded? ? "Refresh vector embedding" : "Generate vector embedding",
                    class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-medium bg-neutral-800 hover:bg-neutral-700 text-neutral-300 hover:text-white border border-neutral-700/60 shadow-sm transition active:scale-95 cursor-pointer" do %>
        <svg class="w-3.5 h-3.5 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span><%= @memory.embedded? ? "Re-vectorize" : "Vectorize" %></span>
      <% end %>

      <!-- Pin / Unpin Button -->
      <%= button_to toggle_pin_memory_path(@memory),
                    method: :patch,
                    title: @memory.pinned? ? "Unpin memory" : "Pin memory",
                    class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-medium border shadow-sm transition active:scale-95 cursor-pointer #{@memory.pinned? ? 'bg-violet-500/20 text-violet-300 border-violet-500/40 hover:bg-violet-500/30' : 'bg-neutral-800 hover:bg-neutral-700 text-neutral-300 hover:text-white border-neutral-700/60'}" do %>
        <svg class="w-4 h-4 shrink-0 #{@memory.pinned? ? 'fill-current text-violet-400' : 'fill-none'}" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
        </svg>
        <span><%= @memory.pinned? ? "Pinned" : "Pin" %></span>
      <% end %>

      <!-- One-Click Copy Markdown Button -->
      <div data-controller="clipboard" data-clipboard-content-value="<%= @memory.body %>">
        <button type="button"
                data-clipboard-target="button"
                data-action="click->clipboard#copy"
                class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium bg-neutral-800 hover:bg-neutral-700 text-violet-300 hover:text-violet-200 border border-violet-500/30 shadow-sm transition active:scale-95 cursor-pointer">
          <svg class="w-4 h-4 shrink-0 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span data-clipboard-target="label">Copy Markdown</span>
        </button>
      </div>

      <!-- Mode Selector Tabs: Preview | Edit | Split -->
      <div class="inline-flex rounded-lg bg-neutral-900 p-0.5 border border-neutral-800 text-xs font-mono">
        <button type="button"
                data-markdown-editor-target="previewTab"
                data-action="click->markdown-editor#setPreviewMode"
                class="px-2.5 py-1 rounded-md font-medium transition bg-neutral-800 text-neutral-100 shadow-sm cursor-pointer">
          Preview
        </button>
        <button type="button"
                data-markdown-editor-target="editTab"
                data-action="click->markdown-editor#setEditMode"
                class="px-2.5 py-1 rounded-md font-medium transition text-neutral-400 hover:text-neutral-200 cursor-pointer">
          Edit
        </button>
        <button type="button"
                data-markdown-editor-target="splitTab"
                data-action="click->markdown-editor#setSplitMode"
                class="px-2.5 py-1 rounded-md font-medium transition text-neutral-400 hover:text-neutral-200 cursor-pointer">
          Split
        </button>
      </div>

      <!-- Delete Memory Button -->
      <%= button_to memory_path(@memory),
                    method: :delete,
                    form: { data: { turbo_confirm: "Are you sure you want to delete this memory?" } },
                    class: "p-1.5 rounded-lg text-neutral-500 hover:text-rose-400 hover:bg-neutral-900 border border-neutral-800/60 transition cursor-pointer",
                    title: "Delete memory" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      <% end %>
    </div>
  </div>

  <!-- Memory Edit / View Form -->
  <%= form_with model: @memory,
                data: { markdown_editor_target: "form" },
                class: "space-y-4" do |f| %>

    <!-- Title Toolbar (Full width since no project selector) -->
    <div class="p-3 bg-neutral-900/50 border border-neutral-800 rounded-xl">
      <div>
        <label class="block text-[10px] font-mono uppercase text-neutral-400 mb-1">Memory Title</label>
        <%= f.text_field :title,
                         data: { markdown_editor_target: "titleInput", action: "input->markdown-editor#onInput" },
                         class: "w-full px-3 py-1.5 bg-neutral-950 border border-neutral-800 rounded-lg text-sm text-neutral-100 focus:outline-none focus:border-violet-500 font-medium" %>
      </div>
    </div>

    <!-- Workspace Panes Container -->
    <div data-markdown-editor-target="splitPane" class="block">
      <!-- Editor Pane (Textarea) -->
      <div data-markdown-editor-target="editorPane" class="hidden space-y-2">
        <div class="flex items-center justify-between text-[11px] font-mono text-neutral-400 px-1">
          <span>Markdown Source</span>
          <button type="button" data-action="click->markdown-editor#saveNow" class="text-violet-400 hover:underline cursor-pointer">
            Save changes
          </button>
        </div>
        <%= f.text_area :body,
                        rows: 18,
                        data: {
                          markdown_editor_target: "textarea",
                          action: "input->markdown-editor#onInput"
                        },
                        placeholder: "Write your memory context here using Markdown (code blocks, lists, notes)...",
                        class: "w-full p-4 bg-neutral-900 border border-neutral-800 rounded-xl text-neutral-200 font-mono text-sm leading-relaxed focus:outline-none focus:border-violet-500/80 focus:ring-1 focus:ring-violet-500/50 resize-y shadow-inner" %>
      </div>

      <!-- Preview Pane (Rendered Markdown) -->
      <div data-markdown-editor-target="previewPane" class="block space-y-2">
        <div class="flex items-center justify-between text-[11px] font-mono text-neutral-400 px-1">
          <span>Rendered Markdown View</span>
          <button type="button" data-action="click->markdown-editor#setEditMode" class="text-violet-400 hover:underline cursor-pointer">
            Edit content
          </button>
        </div>
        <div id="rendered_markdown_container"
             class="markdown-body p-6 bg-neutral-900 border border-neutral-800 rounded-xl min-h-[350px] shadow-sm">
          <% if @memory.body.present? %>
            <%= render_markdown(@memory.body) %>
          <% else %>
            <div class="text-neutral-500 italic text-sm py-8 text-center font-mono">
              (Empty memory body. Click "Edit" or "Split" above to start writing.)
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Attachments Section (ActiveStorage Dropzone) -->
  <div class="pt-6 border-t border-neutral-800/80">
    <%= render "memories/attachments", memory: @memory %>
  </div>

  <!-- Semantically Related Memories -->
  <% if @neighbors.present? %>
    <div class="pt-6 border-t border-neutral-800/80">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-neutral-200 flex items-center gap-2">
          <svg class="w-4 h-4 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          Semantically Related Memories
        </h3>
        <span class="text-xs font-mono text-neutral-500">Nearest neighbors via pgvector</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% @neighbors.each do |neighbor| %>
          <div class="p-4 bg-neutral-900/60 border border-neutral-800 rounded-xl hover:border-violet-500/50 transition">
            <div class="flex items-center justify-between text-xs font-mono text-neutral-500 mb-2">
              <span class="text-emerald-400 font-semibold">
                <%= ((1.0 - neighbor.try(:neighbor_distance).to_f) * 100).round(1) %>% match
              </span>
              <span><%= time_ago_in_words(neighbor.updated_at) %> ago</span>
            </div>
            <%= link_to neighbor.title, memory_path(neighbor), class: "font-medium text-sm text-neutral-200 hover:text-violet-300 block mb-1 truncate" %>
            <p class="text-xs text-neutral-400 font-mono line-clamp-2 leading-relaxed">
              <%= neighbor.body.presence || "(Empty body)" %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
