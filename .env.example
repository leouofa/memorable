# Database password for Docker Compose (defaults to memorable)
POSTGRES_PASSWORD=memorable

# Embedding configuration
# In Docker Compose, reach an Ollama running on the host machine:
EMBEDDING_API_BASE=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_API_KEY=

# Ollama chat configuration (optional, defaults to host gateway)
OLLAMA_API_BASE=http://host.docker.internal:11434/v1
OLLAMA_MODEL=

# Additional hosts to permit in development (comma-separated, e.g. custom domain or tunnel)
RAILS_DEVELOPMENT_HOSTS=
